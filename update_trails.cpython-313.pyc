name: OSM-Traildaten aktualisieren

on:
  schedule:
    - cron: "30 20 * * 0"
      timezone: "Europe/Zurich"
  workflow_dispatch:
    inputs:
      max_dem:
        description: "Neue DEM-Berechnungen in diesem Lauf (0 = alle)"
        required: false
        default: "20"

permissions:
  contents: write
  pages: write
  id-token: write

concurrency:
  group: osm-trail-update
  cancel-in-progress: false

jobs:
  update:
    runs-on: ubuntu-latest
    timeout-minutes: 360
    steps:
      - name: Repository auschecken
        uses: actions/checkout@v4

      - name: Python einrichten
        uses: actions/setup-python@v5
        with:
          python-version: "3.12"

      - name: Python-Abhängigkeiten installieren
        run: |
          python -m pip install --upgrade pip
          python -m pip install \
            "osmium==4.3.1" \
            "pyproj==3.7.2" \
            "requests==2.32.5"

      - name: Installation und Skript prüfen
        run: |
          python -c "import osmium, pyproj, requests; print('Python-Abhängigkeiten OK')"
          python -m py_compile scripts/update_trails.py

      - name: Aktuellen Schweizer OSM-Auszug laden
        run: |
          curl --fail --location --retry 5 --retry-delay 10 \
            --output switzerland-latest.osm.pbf \
            https://download.geofabrik.de/europe/switzerland-latest.osm.pbf
          test -s switzerland-latest.osm.pbf

      - name: Trail-Dateien erzeugen und Steigungen ergänzen
        env:
          MANUAL_MAX_DEM: ${{ github.event.inputs.max_dem }}
        run: |
          MAX_DEM="${MANUAL_MAX_DEM:-500}"
          python scripts/update_trails.py switzerland-latest.osm.pbf \
            --output-dir . \
            --chunks 10 \
            --workers 4 \
            --max-dem "$MAX_DEM"

      - name: Ergebnisdateien prüfen
        run: |
          python - <<'PY'
          import json
          from pathlib import Path

          files = sorted(Path('.').glob('trails-*.geojson'))
          assert len(files) == 10, f'Erwartet 10 Trail-Dateien, gefunden: {len(files)}'
          for path in files:
              data = json.loads(path.read_text(encoding='utf-8'))
              assert data.get('type') == 'FeatureCollection', path
              assert isinstance(data.get('features'), list), path
          meta = json.loads(Path('data-meta.json').read_text(encoding='utf-8'))
          assert 'updated_at' in meta
          print('Ergebnisdateien OK:', meta)
          PY

      - name: Änderungen committen
        run: |
          rm -f switzerland-latest.osm.pbf
          git config user.name "github-actions[bot]"
          git config user.email "41898282+github-actions[bot]@users.noreply.github.com"
          git add trails-*.geojson data-meta.json elevation-cache.json
          if git diff --cached --quiet; then
            echo "Keine Datenänderungen vorhanden."
          else
            git commit -m "OSM-Traildaten automatisch aktualisiert"
            git push
          fi

      - name: Pages-Dateien zusammenstellen
        run: |
          rm -rf _site
          mkdir _site
          cp index.html manifest.webmanifest service-worker.js icon-192.svg icon-512.svg .nojekyll data-meta.json _site/
          cp trails-*.geojson _site/

      - name: GitHub-Pages-Artefakt hochladen
        uses: actions/upload-pages-artifact@v4
        with:
          path: _site

  deploy:
    needs: update
    runs-on: ubuntu-latest
    environment:
      name: github-pages
      url: ${{ steps.deployment.outputs.page_url }}
    steps:
      - name: GitHub Pages veröffentlichen
        id: deployment
        uses: actions/deploy-pages@v4
